# lazy_bot settings: copy this file to .env and fill in your own values. .env is never committed.
# Put a value in single quotes if it contains " #" or starts/ends with spaces, e.g. PASSWORD='my #pass'.

# ---------- Your daily log ----------
# CSV with the columns date,hours,description (one row per day; rows on the same date are added up).
CSV_PATH=timesheet.csv
# Date formats the CSV may use, tried in order (ISO 2026-10-12 always works).
# Excel with US settings saves 10/12/2026 (%m/%d/%Y); with Brazilian settings 12/10/2026 (%d/%m/%Y).
DATE_FORMATS=%Y-%m-%d,%m/%d/%Y

# ---------- The weekly run ----------
# Platforms to fill, in this order. Remove the ones you don't use.
PLATFORMS=clockify,timesheetportal,kronos,globalsource
# confirm = fill and save everywhere, then ask before submitting (recommended)
# submit  = fill and submit without asking
# save    = fill and save only; you submit yourself (sites without drafts, like Deel, are skipped)
SUBMIT_MODE=confirm
# A week is due from this day and time on. The scheduled task runs then, and at logon to catch up.
RUN_DAY=FRI
RUN_TIME=16:00
# How long to wait for you to finish signing in (MFA / 2FA) in an Edge window.
LOGIN_TIMEOUT_SECONDS=300

# ---------- WWT Kronos (UKG), signs in through WWT Okta ----------
KRONOS_URL=https://wwt-sso.prd.mykronos.com/timekeeping#/myTimecard?ctxt=myTimecard
KRONOS_EMAIL=
# Leave empty and type it yourself when the Okta session expires (recommended for a company password).
KRONOS_PASSWORD=
# true = after your "y", also click Approve on the timecard.
KRONOS_APPROVE=false

# ---------- Timesheet Portal (Cloud Decisions UK) ----------
TIMESHEETPORTAL_URL=https://clouddecisionsuk.timesheetportal.com/
TIMESHEETPORTAL_EMAIL=
TIMESHEETPORTAL_PASSWORD=

# ---------- GlobalSource (Deel) ----------
GLOBALSOURCE_URL=https://hiring.globalsource.cloud/time-attendance/contracts
GLOBALSOURCE_EMAIL=
GLOBALSOURCE_PASSWORD=

# ---------- Advanced (optional) ----------
# One Edge profile per platform keeps each sign-in. Default: %LOCALAPPDATA%\lazy_bot\profiles
# PROFILES_DIR=
# Where finished weeks are copied, run logs go, and progress is remembered (defaults shown).
# ARCHIVE_DIR=archive
# LOGS_DIR=logs
# STATE_PATH=state.json
# If a site's single sign-on misbehaves under automation: start Edge normally and connect to it,
# and/or pass extra Edge switches, e.g.
# KRONOS_BROWSER_MODE=attach
# KRONOS_BROWSER_ARGS=--enable-automation
